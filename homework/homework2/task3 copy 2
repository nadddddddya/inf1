from random import randint 

minRange = -10
maxRange = 10

x = [randint(minRange, maxRange) for i in range(10)]
print (x)

n = int(input("podaj x: "))
counter = 0
for i in range(len(x)):
    if x[i] == n:
        counter += 1
print("Liczba wystąpień liczby " + str(n) + " w tablicy to: " + str(counter))
